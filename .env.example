# =============================================================================
#  shalgalt-platform — орчны хувьсагчийн жишээ
#  Хэрэглэх: cp .env.example .env   (Windows: Copy-Item .env.example .env)
#  ЭНЭ ФАЙЛД БОДИТ НУУЦ ҮГ БИЧИХГҮЙ. .env файл git-д ордоггүй.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Ерөнхий
# -----------------------------------------------------------------------------
# Ажиллах горим: development | test | production
# ⚠ `NODE_ENV` БИШ — Vite нь .env дотор NODE_ENV=production байхыг зөвшөөрдөггүй.
APP_ENV=development
TZ=Asia/Ulaanbaatar

# -----------------------------------------------------------------------------
# 2. API сервер (apps/api)
# -----------------------------------------------------------------------------
API_PORT=3000
# 0.0.0.0 бол LAN дотроос хандах боломжтой. Зөвхөн localhost бол 127.0.0.1
API_HOST=0.0.0.0

# -----------------------------------------------------------------------------
# 3. Өгөгдлийн сан (Prisma)
#    Нэг schema — provider-оор dev/prod ялгана.
#    dev  : sqlite      -> DATABASE_URL="file:./dev.db"
#    prod : postgresql  -> DATABASE_URL="postgresql://user:pass@host:5432/db?schema=public"
# -----------------------------------------------------------------------------
DATABASE_PROVIDER=sqlite
DATABASE_URL="file:./dev.db"

# Docker Compose-д ашиглах PostgreSQL тохиргоо (prod профайл)
POSTGRES_USER=shalgalt
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=shalgalt
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# 4. LAN горим (`pnpm lan`) — багшийн зөөврийн компьютер дээр ажиллах сервер
# -----------------------------------------------------------------------------
LAN_PORT=3000
LAN_DATABASE_URL="file:./lan.db"
# LAN сервер өөрөө клиент болж энэ үндсэн сервер рүү sync хийнэ.
# Хоосон орхивол LAN сервер дээшээ sync хийхгүй, зөвхөн дотооддоо ажиллана.
UPSTREAM_API_URL=

# -----------------------------------------------------------------------------
# 5. CORS
#    Таслалаар тусгаарласан origin жагсаалт.
#    CORS_ALLOW_LAN=true үед 10.x / 172.16-31.x / 192.168.x хаягуудыг нэмж зөвшөөрнө.
# -----------------------------------------------------------------------------
WEB_ORIGIN=http://localhost:5173
CORS_ALLOW_LAN=true

# -----------------------------------------------------------------------------
# 6. Хурдны хязгаарлалт (express-rate-limit)
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MIN=1
RATE_LIMIT_MAX=60

# -----------------------------------------------------------------------------
# 7. Тайлангийн файл байршуулалт (multer)
# -----------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# -----------------------------------------------------------------------------
# 7.1. Вэб апп-ыг ижил портоор үйлчлэх (нэг процессоор бүгдийг)
#      Тохируулбал API нь PWA-г мөн үйлчилнэ → nginx, Docker шаардлагагүй.
#      Сургууль доторх (LAN) 24/7 суурилуулалтад ЭНЭ ХУВИЛБАРЫГ АШИГЛАНА.
#      Хоосон бол зөвхөн API ажиллана (dev үед Vite тусад нь ажиллана).
# -----------------------------------------------------------------------------
SERVE_WEB_DIR=

# -----------------------------------------------------------------------------
# 8. Имэйл (Nodemailer / SMTP)
#    Dev: Mailpit — docker compose up mail  (SMTP :1025, веб UI :8025)
#    Prod: жинхэнэ SMTP (Gmail бол App Password ашиглана)
# -----------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Шалгалтын платформ <noreply@shalgalt.local>"
# Имэйл илгээх оролдлогын дээд тоо (sync engine дахин оролдоно)
EMAIL_MAX_ATTEMPTS=5

# -----------------------------------------------------------------------------
# 9. Веб клиент (apps/web) — зөвхөн VITE_ угтвартай хувьсагч браузерт хүрнэ.
#    ЭДГЭЭР НЬ НИЙТЭД ИЛ. Нууц утга ЭНД БИЧИХГҮЙ.
# -----------------------------------------------------------------------------
VITE_APP_NAME="Шалгалтын платформ"
# Хоосон бол клиент ижил origin руу ханддаг (Vite proxy / нэг домэйн deploy).
VITE_API_BASE_URL=
# QR код үүсгэхэд ашиглах нийтийн хаяг (online deliveryMode).
# Хоосон бол браузерын window.location.origin-ыг ашиглана.
VITE_PUBLIC_APP_URL=http://localhost:5173
# offlineQr горимд нэг QR-д багтаах хамгийн их байт
VITE_QR_MAX_BYTES=1200
